# Root package.json for monorepo
{
  "name": "@silentcall/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/mobile"
  ],
  "scripts": {
    "install-all": "npm install --workspaces",
    "build": "npm run build --workspaces",
    "dev:server": "npm run dev --workspace=@silentcall/server",
    "dev:mobile": "npm run start --workspace=@silentcall/mobile",
    "docker:up": "cd infra && docker-compose up --build",
    "docker:down": "cd infra && docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
